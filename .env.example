# Copy to .env and replace this placeholder before starting PostgreSQL.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
POSTGRES_USER=modelmedic
POSTGRES_DB=modelmedic
# Local development binds only to loopback.
API_PORT=8000
FRONTEND_PORT=5173
# Computational resource limits, enforced by the API/validation worker.
MM_UPLOAD_MAX_BYTES=26214400
MM_MAX_ROWS=50000
MM_MAX_COLUMNS=100
MM_MAX_FEATURES=50
MM_MAX_CATEGORIES=100
MM_MAX_ENCODED_COLUMNS=2000
